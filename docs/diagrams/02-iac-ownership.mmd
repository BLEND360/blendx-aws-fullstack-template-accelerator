%% AWS Fullstack Template — Deploy-time view: which CDK stack owns what
%% Import into Lucidchart: File > Import Diagram > Mermaid.
%% Companion to 01-system-layers.mmd, which shows the runtime view.
%% The runtime diagram answers "who calls whom".
%% This one answers "who creates what, and in what order".

flowchart TB

TOML["project.toml<br/>the only file a human edits<br/>name · account · region · env sizing<br/>harness arn + endpoint"]
CFG["infra/config.py<br/>derives EVERY resource name<br/>no stack writes a name literally"]
TOML --> CFG

%% ─────────────────────────────────────────────────────────────────
subgraph BOOT["STEP 0 · One time per AWS account — run by an operator"]
  direction TB
  B_SCRIPT["scripts/bootstrap.py<br/>idempotent · safe to re-run"]
  B_CDK["cdk bootstrap<br/>CDK staging resources"]
  B_OIDC["GitHub OIDC provider<br/>token.actions.githubusercontent.com"]
  B_VARS["Prints the GitHub repo variables to set"]
  B_SCRIPT --> B_CDK
  B_SCRIPT --> B_OIDC
  B_SCRIPT --> B_VARS
end

%% ─────────────────────────────────────────────────────────────────
subgraph S_ROLES["STACK 1 · RolesStack — the bootstrap dependency"]
  direction TB
  RS_DEPLOY["GitHub Actions deploy role<br/>OIDC trust scoped to one repo<br/>handles this org's subject-claim customization"]
  RS_TASK["ECS task role<br/>scoped to named tables,<br/>the named secret, the named harness"]
  RS_EXEC["ECS execution role<br/>pull image · write logs"]
  RS_HAR["Harness execution role<br/>model invoke + managed memory"]
  RS_NOTE["Referenced BY NAME everywhere else,<br/>never by cross-stack reference"]
end

%% ─────────────────────────────────────────────────────────────────
subgraph S_AUTH["STACK 2 · AuthStack — outlives the app"]
  direction TB
  AS_POOL["Cognito user pool"]
  AS_CLIENT["Public app client<br/>PKCE · no secret · scopes openid email profile"]
  AS_DOMAIN["Hosted login domain"]
  AS_GROUP["Access group"]
  AS_LAMBDA["Pre-token-generation Lambda<br/>denies issuance outside the group"]
  AS_SAML["SAML identity provider<br/>created only when enabled"]
  AS_OUT["Outputs: pool id · client id · domain"]
end

%% ─────────────────────────────────────────────────────────────────
subgraph S_DATA["STACK 3 · DataStack — outlives the app"]
  direction TB
  DS_SESS["Table: sessions<br/>retain on delete outside dev"]
  DS_ITEM["Table: items<br/>worked example"]
  DS_NOTE["Separate stack so an app rollback<br/>cannot reach user data"]
end

%% ─────────────────────────────────────────────────────────────────
subgraph S_HAR["STACK 4 · Harness — conditional · agentcore CLI"]
  direction TB
  HS_JSON["harness.json<br/>model + executionRole + memory managed<br/>no tools · no skills"]
  HS_MEM["Managed memory<br/>holds conversation history<br/>retain on delete outside dev"]
  HS_OUT["Outputs: Harness&lt;Name&gt;{Id,Arn,Version}<br/>endpoint pointed at the new version"]
  HS_SKIP["NOT deployed when project.toml<br/>supplies harness.arn — prints why"]
end

%% ─────────────────────────────────────────────────────────────────
subgraph S_APP["STACK 5 · AppStack — the only stack a routine deploy touches"]
  direction TB
  AP_VPC["VPC and subnets<br/>created by default · importable by id"]
  AP_SG["Security groups<br/>egress deliberately NOT declared"]
  AP_CLUSTER["ECS cluster"]
  AP_TASKDEF["Task definition<br/>env from config · secrets from Secrets Manager"]
  AP_SVC["Fargate service<br/>ECS Exec enabled"]
  AP_ALB["Internal ALB + target group<br/>health check /health"]
  AP_S3["Private S3 bucket + origin access control"]
  AP_CF["CloudFront distribution + behaviors"]
  AP_SECRET["App JWT signing secret<br/>generated here, never in the repo"]
  AP_OUT["Outputs: bucket · distribution id · public URL"]
end

%% ─────────────────────────────────────────────────────────────────
subgraph PIPE["CI · One ordered pipeline on push to the default branch"]
  direction TB
  PL_TEST["test<br/>api · web · infra · lint · types"]
  PL_ROLES["deploy RolesStack"]
  PL_AUTH["deploy AuthStack"]
  PL_DATA["deploy DataStack"]
  PL_HAR["agentcore deploy · point endpoint · wait READY<br/>skipped when an ARN is configured"]
  PL_IMG["build + push image<br/>immutable tag sha-runattempt"]
  PL_APP["deploy AppStack"]
  PL_SPA["publish SPA to S3 + invalidate CDN"]
  PL_SMOKE["smoke test the public URL<br/>asserts JSON, not just status 200"]

  PL_TEST --> PL_ROLES --> PL_AUTH --> PL_DATA --> PL_HAR --> PL_IMG --> PL_APP --> PL_SPA --> PL_SMOKE
end

%% ─────────────────────────────────────────────────────────────────
%% OWNERSHIP AND ORDER
%% ─────────────────────────────────────────────────────────────────
CFG --> S_ROLES
CFG --> S_AUTH
CFG --> S_DATA
CFG --> S_HAR
CFG --> S_APP

B_SCRIPT ==>|"creates first, so CI has<br/>something to assume"| S_ROLES
RS_DEPLOY ==>|"assumed by every CI deploy"| PIPE

RS_TASK -.->|"referenced by name"| AP_TASKDEF
RS_EXEC -.->|"referenced by name"| AP_TASKDEF
RS_HAR -.->|"referenced by name"| HS_JSON

AS_OUT -->|"pool id · client id<br/>to task env AND SPA build"| AP_TASKDEF
DS_SESS -->|"table name as a plain string,<br/>never a cross-stack ref"| AP_TASKDEF
DS_ITEM -->|"table name"| AP_TASKDEF
HS_OUT -->|"harness ARN + endpoint"| AP_TASKDEF
TOML -.->|"harness.arn + endpoint, when set,<br/>replace HS_OUT"| AP_TASKDEF

AP_OUT -->|"bucket + distribution id"| PL_SPA
AP_CF -.->|"domain becomes CORS_ORIGINS"| AP_TASKDEF

%% Why plain strings
WHYREF["Why plain strings, not cross-stack refs:<br/>a CDK reference creates a CloudFormation export,<br/>an export in use cannot be deleted, and the<br/>rollback reads 'cannot delete export in use'.<br/>Plain strings keep every deploy order valid."]
WHYREF --- DS_SESS

%% ─────────────────────────────────────────────────────────────────
classDef src fill:#ffffff,stroke:#00EDED,stroke-width:2px,color:#053057
classDef stack fill:#ffffff,stroke:#053057,stroke-width:1px,color:#053057
classDef store fill:#f5f5f5,stroke:#053057,stroke-width:1px,color:#053057
classDef ci fill:#f5f5f5,stroke:#64748b,stroke-width:1px,color:#1a1a1a
classDef note fill:#f5f5f5,stroke:#64748b,stroke-width:1px,color:#64748b

class TOML,CFG src
class RS_DEPLOY,RS_TASK,RS_EXEC,RS_HAR stack
class AS_POOL,AS_CLIENT,AS_DOMAIN,AS_GROUP,AS_LAMBDA,AS_SAML,AS_OUT stack
class HS_JSON,HS_OUT stack
class AP_VPC,AP_SG,AP_CLUSTER,AP_TASKDEF,AP_SVC,AP_ALB,AP_S3,AP_CF,AP_SECRET,AP_OUT stack
class DS_SESS,DS_ITEM,HS_MEM store
class B_SCRIPT,B_CDK,B_OIDC,B_VARS ci
class PL_TEST,PL_ROLES,PL_AUTH,PL_DATA,PL_HAR,PL_IMG,PL_APP,PL_SPA,PL_SMOKE ci
class RS_NOTE,DS_NOTE,HS_SKIP,WHYREF note

%% Subgraphs are styled explicitly: Mermaid's default cluster fill is a cream
%% that is not in the Blend palette.
classDef group fill:#ffffff,stroke:#64748b,stroke-width:1px,color:#053057
class BOOT,S_ROLES,S_AUTH,S_DATA,S_HAR,S_APP,PIPE group
